lue="100">100 Гц</option><option value="200">200 Гц</option></select><button style="margin-top:14px">Сохранить PWM и защиту</button></form></section><section><h2>Ошибки движения</h2><p id="fault" role="alert">Загрузка…</p><form id="reset"><label for="resetAxis">Сбросить ошибку</label><select id="resetAxis"><option value="all">Обе оси</option><option value="az">AZ</option><option value="el">EL</option></select><button>Сбросить ошибку</button></form><p class="small">Сброс останавливает выбранную ось. Если причина остаётся, ошибка появится снова.</p></section><section><h2>Подключение и диагностика</h2><p><a href="/hardware">Bluetooth, Wi-Fi, точка доступа, GPIO и оборудование</a></p><p><a href="/adc">Диагностика датчиков положения</a></p><p><a href="/calibration">Диапазоны и калибровка AZ/EL</a></p></section></fieldset><script>
